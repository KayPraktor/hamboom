{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "canvas-core-demo",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@hamboom/canvas-core", "dev"],
      "port": 15180,
      "url": "http://127.0.0.1:15180"
    },
    {
      "name": "api",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--env-file-if-exists=.env", "apps/api/src/server.ts"],
      "port": 3002,
      "url": "http://localhost:3002"
    }
  ]
}
