# .env.example — تنها منبعِ حقیقتِ نامِ متغیرهای محیطی.
#
# هر متغیر جدید **اینجا هم** اضافه شود. مرجعِ کاملِ همه‌ی متغیرهای پروژه (شاملِ
# بخش‌هایی که هنوز ماژولشان ساخته نشده — S3، احراز هویت، پیامک، زرین‌پال) در
# PLAN.md بخش ۴ است.
#
# ⚠️ این فایل فعلاً فقط بخش‌هایی را دارد که **الان مصرف‌کننده دارند** (ماژول M2).
# عمداً: یک .env.example پر از متغیرِ SMTP و زرین‌پال برای اپ‌هایی که وجود ندارند،
# اولین چیزی است که از واقعیت واگرا می‌شود. M3/M4 بخش‌های خودشان را از PLAN بخش ۴
# اضافه می‌کنند.
#
# قاعده (PLAN بخش ۴): فقط `packages/config` اجازه‌ی خواندن `process.env` را دارد.
# اعتبارسنجی با zod و fail-fast در بوت.

# ── عمومی ───────────────────────────────────────────
NODE_ENV=development
APP_ENV=local                          # local | staging | production
LOG_LEVEL=debug
TZ=UTC

# ── PostgreSQL ──────────────────────────────────────
#
# 💡 اگر روی ماشینت از قبل یک PostgreSQL بومی روی ۵۴۳۲ نشسته، `docker compose up`
#    تعارضِ پورت می‌دهد. لازم نیست چیزی را متوقف کنی — در `.env`ِ **خودت** (که
#    gitignore است) پورت را عوض کن؛ compose از قبل پارامتری است:
#      POSTGRES_PORT=5433
#      DATABASE_URL=postgres://hamboom:hamboom_dev_pw@localhost:5433/hamboom
POSTGRES_USER=hamboom
POSTGRES_PASSWORD=hamboom_dev_pw
POSTGRES_DB=hamboom
POSTGRES_PORT=5432
DATABASE_URL=postgres://hamboom:hamboom_dev_pw@localhost:5432/hamboom
DATABASE_SSL=false                     # آروان: true
DATABASE_POOL_MAX=20

# ── Redis ───────────────────────────────────────────
REDIS_PASSWORD=hamboom_dev_pw
REDIS_PORT=6379
REDIS_URL=redis://:hamboom_dev_pw@localhost:6379/0
REDIS_TLS=false                        # آروان: احتمالاً true

# ── Realtime (M2) ───────────────────────────────────
RT_PORT=3001
RT_MAX_ROOMS_PER_NODE=500
RT_ROOM_IDLE_TIMEOUT_MS=120000
RT_HEARTBEAT_INTERVAL_MS=25000         # مهم: کوتاه‌تر از idle timeout لودبالانسر آروان
RT_SNAPSHOT_EVERY_UPDATES=500
RT_SNAPSHOT_EVERY_MS=60000
RT_SNAPSHOT_DIR=.hamboom/snapshots     # جای Object Storage تا M3 (D-3، اصل P3)
RT_MAX_DOC_BYTES=52428800              # ۵۰MB سقف سخت هر بورد

# ── Object Storage (S3-compatible) — M3، packages/storage ────
#
# سوییچ به آروان فقط با همین‌ها (PLAN §۴): endpoint/کلیدها عوض می‌شوند، ولی region و
# force-path-style ثابت می‌مانند. ⚠️ S3_FORCE_PATH_STYLE متغیرِ مستقل است، نه ثابت
# (ADR-013، probe ۳٫۰: رفتارِ presign بین سرویس‌های S3 فرق می‌کند؛ MinIO لازمش دارد).
# exports/public-base-url عمداً نیامده — تا مصرف‌کننده‌شان بعد از M3 بیاید.
S3_ENDPOINT=http://localhost:9000      # آروان: https://s3.ir-thr-at1.arvanstorage.ir
S3_REGION=ir-thr-at1                   # آروان: همان
S3_ACCESS_KEY_ID=hamboom_minio
S3_SECRET_ACCESS_KEY=hamboom_minio_dev_pw
S3_FORCE_PATH_STYLE=true               # آروان: همان true
S3_PRESIGN_TTL_SECONDS=900             # TTL پیش‌فرضِ URLهای امضاشده
S3_BUCKET_ASSETS=hamboom-assets        # مصرف‌کننده: گام ۳٫۳ (AssetTransport)
S3_BUCKET_SNAPSHOTS=hamboom-snapshots  # مصرف‌کننده: گام ۳٫۲ (StorageSnapshotStore)
UPLOAD_MAX_BYTES=10485760              # سقفِ سختِ سراسریِ آپلود (۱۰MB) — apps/api گام ۵٫۴

# ── احراز هویتِ توسعه‌ای (M2 — تا وقتی M3 نیامده) ────
#
# ★ خطر: `DevBoardAuthority` با همین کلید توکن صادر و اعتبارسنجی می‌کند. هرکس این
#   مقدار را بداند می‌تواند برای خودش نقشِ owner بسازد. به همین دلیل سرور با
#   APP_ENV=production و پیاده‌سازیِ dev **بالا نمی‌آید** (ADR-031، گام ۴٫۱).
RT_DEV_JWT_SECRET=change_me_dev_only_32_chars_minimum

# ── احراز هویتِ M3 (apps/api، فاز ۵) ─────────────────
# ★ رازِ HS256؛ auth-core param می‌گیردش (نه process.env). حداقل ۳۲ کاراکتر.
JWT_SECRET=change_me_dev_only_jwt_secret_at_least_32_chars_long
ACCESS_TOKEN_TTL_SECONDS=900            # ۱۵ دقیقه
REFRESH_TOKEN_TTL_SECONDS=2592000      # ۳۰ روز
RT_TOKEN_TTL_SECONDS=60                # توکنِ کوتاه‌عمرِ WS (سقفِ آینده ۲×)

# ── OTP (M3) ────────────────────────────────────────
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60
# OTP_DEV_FIXED_CODE=123456            # کد ثابتِ dev (اختیاری)؛ بدونش تصادفی و از لاگِ MockSms

# ── محدودیتِ نرخِ apps/api (M3) ─────────────────────
# store پیش‌فرض حافظه‌ای (تک‌نود)؛ چندنودی → Redis (فاز بعد). سقفِ OTP سخت‌تر (پیامک هزینه دارد).
RATE_LIMIT_MAX=100                     # سقفِ سراسری در هر پنجره
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_OTP_MAX=5                   # سقفِ سخت‌ترِ /auth/otp/request

# ── پورتِ apps/api (M3) ─────────────────────────────
# PORT=3002                            # ابزارِ preview/میزبانی خودش تزریق می‌کند؛ پیش‌فرض ۳۰۰۲
