# .env.example — تنها منبعِ حقیقتِ نامِ متغیرهای محیطی.
#
# هر متغیر جدید **اینجا هم** اضافه شود. مرجعِ کاملِ همه‌ی متغیرهای پروژه (شاملِ
# بخش‌هایی که هنوز ماژولشان ساخته نشده — S3، احراز هویت، پیامک، زرین‌پال) در
# PLAN.md بخش ۴ است.
#
# ⚠️ این فایل فعلاً فقط بخش‌هایی را دارد که **الان مصرف‌کننده دارند** (ماژول M2).
# عمداً: یک .env.example پر از متغیرِ SMTP و زرین‌پال برای اپ‌هایی که وجود ندارند،
# اولین چیزی است که از واقعیت واگرا می‌شود. M3/M4 بخش‌های خودشان را از PLAN بخش ۴
# اضافه می‌کنند.
#
# قاعده (PLAN بخش ۴): فقط `packages/config` اجازه‌ی خواندن `process.env` را دارد.
# اعتبارسنجی با zod و fail-fast در بوت.

# ── عمومی ───────────────────────────────────────────
NODE_ENV=development
APP_ENV=local                          # local | staging | production
LOG_LEVEL=debug
TZ=UTC

# ── PostgreSQL ──────────────────────────────────────
#
# 💡 اگر روی ماشینت از قبل یک PostgreSQL بومی روی ۵۴۳۲ نشسته، `docker compose up`
#    تعارضِ پورت می‌دهد. لازم نیست چیزی را متوقف کنی — در `.env`ِ **خودت** (که
#    gitignore است) پورت را عوض کن؛ compose از قبل پارامتری است:
#      POSTGRES_PORT=5433
#      DATABASE_URL=postgres://hamboom:hamboom_dev_pw@localhost:5433/hamboom
POSTGRES_USER=hamboom
POSTGRES_PASSWORD=hamboom_dev_pw
POSTGRES_DB=hamboom
POSTGRES_PORT=5432
DATABASE_URL=postgres://hamboom:hamboom_dev_pw@localhost:5432/hamboom
DATABASE_SSL=false                     # آروان: true
DATABASE_POOL_MAX=20

# ── Redis ───────────────────────────────────────────
REDIS_PASSWORD=hamboom_dev_pw
REDIS_PORT=6379
REDIS_URL=redis://:hamboom_dev_pw@localhost:6379/0
REDIS_TLS=false                        # آروان: احتمالاً true

# ── Realtime (M2) ───────────────────────────────────
RT_PORT=3001
RT_MAX_ROOMS_PER_NODE=500
RT_ROOM_IDLE_TIMEOUT_MS=120000
RT_HEARTBEAT_INTERVAL_MS=25000         # مهم: کوتاه‌تر از idle timeout لودبالانسر آروان
RT_SNAPSHOT_EVERY_UPDATES=500
RT_SNAPSHOT_EVERY_MS=60000
RT_SNAPSHOT_DIR=.hamboom/snapshots     # جای Object Storage تا M3 (D-3، اصل P3)
RT_MAX_DOC_BYTES=52428800              # ۵۰MB سقف سخت هر بورد

# ── احراز هویتِ توسعه‌ای (M2 — تا وقتی M3 نیامده) ────
#
# ★ خطر: `DevBoardAuthority` با همین کلید توکن صادر و اعتبارسنجی می‌کند. هرکس این
#   مقدار را بداند می‌تواند برای خودش نقشِ owner بسازد. به همین دلیل سرور با
#   APP_ENV=production و پیاده‌سازیِ dev **بالا نمی‌آید** (ADR-031، گام ۴٫۱).
RT_DEV_JWT_SECRET=change_me_dev_only_32_chars_minimum
