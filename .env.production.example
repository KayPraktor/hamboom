# .env.production.example — نمونه‌ی محیطِ **استقرار** (M5 گام ۴٫۲).
#
#   cp .env.production.example .env.production   # و همه‌ی «‼️»ها را عوض کن
#   docker compose -f infra/docker/docker-compose.prod.yml --env-file .env.production up -d
#
# ⚠️ **این با `.env.example` فرق دارد و جایگزینش نیست.** آن یکی فهرستِ کاملِ متغیرهای
# **توسعه** است؛ این یکی فقط چیزهایی را دارد که
# [`docker-compose.prod.yml`](infra/docker/docker-compose.prod.yml) واقعاً مصرف می‌کند،
# با علامتِ اینکه هرکدام **راز** است یا **خطرناک**.
#
# ── علامت‌ها ────────────────────────────────────────────────────────────────
#   ‼️  راز — هرگز کامیت نشود، و روی VM با `chmod 600` بماند
#   ⚠️  خطرناک — مقدارِ اشتباهش یا اپ را بالا نمی‌آورد یا بی‌صدا خرابی می‌سازد
#   ★  گاردِ بوت دارد: با مقدارِ بد، سرویس **بالا نمی‌آید** (M5 گام ۴٫۱)
#
# ⚠️⚠️ **میزبان‌ها این‌جا نامِ سرویسِ compose اند، نه `localhost`** — کانتینرِ api داخلِ
# شبکه‌ی خودش است. این تفاوت، اولین چیزی است که در استقرار فراموش می‌شود.

# ── عمومی ───────────────────────────────────────────
# ⚠️ ★ `production` یعنی همه‌ی گاردها فعال‌اند. **تا وقتی درگاهِ پرداخت و سرویسِ پیامکِ
#    واقعی سیم‌کشی نشده‌اند، `staging` بگذار** — با mock کاملاً بالا می‌آید.
APP_ENV=staging
LOG_LEVEL=info
TZ=UTC
# تگِ ایمیج‌ها. با CI (M5-D10 هنوز باز است) این می‌شود شناسه‌ی کامیت.
IMAGE_TAG=local
# پورتی که فقط سرویسِ `web` روی هاست باز می‌کند. لبه‌ی TLS جلوترش می‌نشیند (فاز ۹).
WEB_PORT=8080

# ── PostgreSQL ──────────────────────────────────────
# ⚠️ `postgres` نامِ سرویس در شبکه‌ی compose است — نه `localhost`.
POSTGRES_USER=hamboom
POSTGRES_DB=hamboom
POSTGRES_PASSWORD=‼️_یک_رمزِ_تصادفیِ_بلند
DATABASE_URL=postgres://hamboom:‼️_همان_رمز@postgres:5432/hamboom
# ⚠️ ★ `false` فقط تا وقتی دیتابیس **در همان compose** است (ADR-059). اگر روزی
#    `DATABASE_URL` را به یک دیتابیسِ Managed بردی و این را `true` نکردی، اپ
#    **بالا نمی‌آید** — عمدی، وگرنه رمز روی شبکه رمزنشده می‌رفت.
DATABASE_SSL=false
DATABASE_POOL_MAX=20

# ── Redis ───────────────────────────────────────────
REDIS_PASSWORD=‼️_یک_رمزِ_تصادفیِ_بلند
REDIS_URL=redis://:‼️_همان_رمز@redis:6379/0
REDIS_TLS=false

# ── احراز هویت ──────────────────────────────────────
# ‼️★ رازِ HS256. **هر توکنی با این امضا می‌شود** — لو رفتنش یعنی جعلِ هویتِ هر کاربر.
#    حداقل ۳۲ کاراکتر، و گاردِ بوت رازهای «توسعه‌ای» را رد می‌کند.
#    ساخت:  openssl rand -hex 32
JWT_SECRET=‼️_openssl_rand_hex_32
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
RT_TOKEN_TTL_SECONDS=60

# ── OTP ─────────────────────────────────────────────
# ⚠️ ★ `OTP_DEV_FIXED_CODE` این‌جا **نباید باشد** — گاردِ بوت وجودش را رد می‌کند.
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60

# ── محدودیتِ نرخ ────────────────────────────────────
# ⚠️ store حافظه‌ای و **تک‌نودی** است؛ با نودِ دوم باید Redis شود (فاز ۶٫۳).
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_OTP_MAX=5

# ── Object Storage (آروان) ──────────────────────────
# ⚠️ سه باکت لازم است (M5-D7): دو تای زیر + یک باکتِ **جدا** برای پشتیبان (فاز ۷).
S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
S3_REGION=ir-thr-at1
S3_ACCESS_KEY_ID=‼️_کلیدِ_دسترسیِ_آروان
S3_SECRET_ACCESS_KEY=‼️_کلیدِ_محرمانه‌ی_آروان
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=900
S3_BUCKET_ASSETS=hamboom-assets
S3_BUCKET_SNAPSHOTS=hamboom-snapshots
# ⚠️ ★ باکتِ **سوم و جدا** (M5-D7، فاز ۷). یک دامنه‌ی خرابی برای داده و پشتیبانش یعنی
#    هیچ پشتیبانی. اگر سرویس اجازه می‌دهد، کلیدِ دسترسیِ این باکت را **فقط-نوشتن** بگیر.
S3_BUCKET_BACKUPS=hamboom-backups
UPLOAD_MAX_BYTES=10485760

# ── Realtime ────────────────────────────────────────
# ⚠️ heartbeat باید از idle timeoutِ هر پروکسی/لودبالانسرِ جلوتر **کوتاه‌تر** باشد
#    (ADR-006). nginxِ ما ۳۶۰۰s گذاشته، پس فعلاً امن است.
RT_HEARTBEAT_INTERVAL_MS=25000
RT_ROOM_IDLE_TIMEOUT_MS=120000
RT_SNAPSHOT_EVERY_UPDATES=500
RT_SNAPSHOT_EVERY_MS=60000
# ⚠️ هیچ‌کدام از این دو گیتِ **موثری** نیستند: بوردِ ۵۰۰۰ عنصری ۳٫۶MB سند دارد ولی
#    ۷۶MB حافظه (docs/realtime-baseline.md). قیدِ واقعی حافظه است — فاز ۵ می‌سنجدش.
RT_MAX_ROOMS_PER_NODE=500
RT_MAX_DOC_BYTES=52428800

# ── دامنه ───────────────────────────────────────────
# ⚠️ ★ مسیرِ callback باید **دقیقاً** `/billing/zarinpal/callback` باشد؛ وگرنه api
#    در بوت می‌شکند (نقصِ واقعیِ M4 فاز ۹).
WEB_BASE_URL=https://‼️_دامنه‌ی_شما
ZARINPAL_CALLBACK_URL=https://‼️_دامنه‌ی_شما/billing/zarinpal/callback

# ── پرداخت ──────────────────────────────────────────
# ⚠️ ★ با `APP_ENV=production`، مقدارِ `mock` **بالا نمی‌آید** (ADR-049) — وگرنه هر
#    اشتراکی رایگان فعال می‌شود. تا تاییدِ حسابِ زرین‌پال: APP_ENV=staging + mock.
PAYMENT_PROVIDER=mock
ZARINPAL_MODE=production
# ‼️ شناسه‌ی ۳۶کاراکتریِ درگاه. با provider=zarinpal، خالی‌بودنش یعنی شکست در بوت.
ZARINPAL_MERCHANT_ID=
# ⚠️ تصمیمِ **حقوقی** نه فنی (ADR-052): تا ثبتِ مالیاتی، عددِ امن صفر است.
VAT_PERCENT=0

# ── آشتی‌دهی ────────────────────────────────────────
# ★★ از M5 فاز ۶ **روشن** است: پیش از هر sweep یک advisory lockِ Postgres گرفته می‌شود،
#    پس با چند نود هم فقط **یکی** کار می‌کند (ADR-060، اثبات‌شده با `pnpm infra:probe-leader`).
# ⚠️ آن قفل برای **اتلاف** است نه درستی — درستی از قفلِ ردیفِ `payments` می‌آید.
# ⊕ اجرای دستی هنوز هست: docker compose … --profile ops run --rm reconcile
BILLING_RECONCILE_ENABLED=true
BILLING_RECONCILE_INTERVAL_SECONDS=300
BILLING_PENDING_STALE_MINUTES=20
# ⚠️ ۷۲ یک **حدس** است — عددِ واقعی را باید از پشتیبانیِ زرین‌پال پرسید (TODO M5).
BILLING_PENDING_EXPIRE_HOURS=72
BILLING_RECONCILE_BATCH=50
# ⚠️ تنها گامی که «حدس» می‌زند؛ عملِ آگاهانه‌ی اپراتور است، نه رفتارِ خودکار.
BILLING_ADOPT_ORPHANS=false

# ── ⛔ چیزهایی که این‌جا **نباید** باشند ─────────────
# RT_DEV_JWT_SECRET   ★ گاردِ بوت وجودش را رد می‌کند (پیاده‌سازیِ dev از M3 حذف شده)
# OTP_DEV_FIXED_CODE  ★ همین‌طور — نشانه‌ی یک .envِ کپی‌شده از dev
