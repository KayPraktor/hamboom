{
  "name": "hamboom",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "هم‌بوم — پلتفرم وایت‌بورد همکاری بلادرنگ، فارسی و ریالی",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:root": "eslint .",
    "lint:css": "stylelint \"packages/*/src/**/*.css\" \"packages/*/dev/**/*.css\"",
    "typecheck": "tsc -p tsconfig.json && turbo run typecheck",
    "typecheck:root": "tsc -p tsconfig.json",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage --concurrency=1 -- --pool=forks --poolOptions.forks.singleFork",
    "verify": "node scripts/verify.mjs",
    "clean": "turbo run clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "license:check": "node scripts/license-check.ts --self-test && node scripts/license-check.ts",
    "license:list": "node scripts/license-check.ts --verbose",
    "db:up": "docker compose -f infra/docker/docker-compose.yml --env-file .env up -d",
    "db:down": "docker compose -f infra/docker/docker-compose.yml --env-file .env down",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "db:smoke": "node --env-file-if-exists=.env scripts/db-smoke.ts",
    "db:fk-test": "node --env-file-if-exists=.env scripts/db-fk-test.ts",
    "db:store-test": "node --env-file-if-exists=.env scripts/db-store-conformance.ts",
    "storage:smoke": "node --env-file-if-exists=.env packages/storage/smoke/round-trip.ts",
    "assets:smoke": "node --env-file-if-exists=.env packages/assets/smoke/round-trip.ts",
    "openapi:gen": "node scripts/gen-openapi.ts",
    "sdk:contract": "node --env-file-if-exists=.env scripts/sdk-contract.ts",
    "rt:durability": "node --env-file-if-exists=.env scripts/rt-durability.ts",
    "rt:compaction": "node --env-file-if-exists=.env scripts/rt-compaction.ts",
    "rt:permission": "node --env-file-if-exists=.env scripts/rt-permission.ts",
    "rt:presence": "node --env-file-if-exists=.env scripts/rt-presence.ts",
    "rt:cluster": "node --env-file-if-exists=.env scripts/rt-cluster.ts",
    "rt:shutdown": "node --env-file-if-exists=.env scripts/rt-shutdown.ts",
    "rt:reconnect": "node --env-file-if-exists=.env scripts/rt-reconnect.ts",
    "rt:bench": "node --expose-gc --env-file-if-exists=.env scripts/rt-bench.ts",
    "rt:dev": "node scripts/rt-dev-server.ts",
    "billing:probe-db": "node --env-file-if-exists=.env scripts/billing-probe-db.ts",
    "billing:probe-idem": "node apps/api/probe/idempotency-callback.ts",
    "billing:probe-math": "node scripts/billing-probe-math.ts",
    "billing:probe-gateway": "node scripts/billing-probe-gateway.ts",
    "billing:settle": "node --env-file-if-exists=.env scripts/billing-probe-settle.ts",
    "billing:quota": "node --env-file-if-exists=.env scripts/billing-probe-quota.ts",
    "billing:reconcile": "node --env-file-if-exists=.env scripts/billing-reconcile.ts",
    "billing:probe-reconcile": "node --env-file-if-exists=.env scripts/billing-probe-reconcile.ts",
    "infra:probe-lock": "node --env-file-if-exists=.env scripts/infra-probe-lock.ts",
    "infra:check-proxy": "node scripts/infra-check-proxy.ts --self-test && node scripts/infra-check-proxy.ts",
    "deps:check": "node scripts/check-workspace-deps.ts --self-test && node scripts/check-workspace-deps.ts",
    "openapi:check": "node scripts/gen-openapi.ts --check",
    "ci:wait": "node --env-file-if-exists=.env scripts/ci-wait-services.mjs",
    "infra:probe-metrics": "node --expose-gc --env-file-if-exists=.env scripts/infra-probe-metrics.ts",
    "infra:probe-leader": "node --env-file-if-exists=.env scripts/infra-probe-leader.ts"
  },
  "dependencies": {
    "@hamboom/config": "workspace:*",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@hamboom/auth-core": "workspace:*",
    "@hamboom/billing-core": "workspace:*",
    "@hamboom/board-access-db": "workspace:*",
    "@hamboom/canvas-sync": "workspace:*",
    "@hamboom/eslint-config": "workspace:*",
    "@hamboom/realtime": "workspace:*",
    "@hamboom/storage": "workspace:*",
    "@hamboom/tsconfig": "workspace:*",
    "@hamboom/ydoc-schema": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "eslint": "^9.17.0",
    "ioredis": "^6.0.0",
    "lib0": "0.2.117",
    "prettier": "^3.4.0",
    "stylelint": "^17.14.1",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "ws": "^8.18.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.20"
  }
}
