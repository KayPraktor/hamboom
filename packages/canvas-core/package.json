{
  "name": "@hamboom/canvas-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "موتور بوم هم‌بوم — رندر، عناصر، ابزارها و قرارداد sync. بدون شبکه.",
  "exports": {
    ".": "./src/index.ts",
    "./sync": "./src/sync/index.ts"
  },
  "scripts": {
    "assets": "node scripts/copy-excalidraw-fonts.mjs",
    "predev": "pnpm run assets",
